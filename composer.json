{
	"name": "newsman/wordpress-plugin",
	"description": "Newsman plugin for WordPress and WooCommerce.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"extra": {
		"installer-name": "newsmanapp",
		"wordpress-install-dir": "tests/wordpress"
	},
	"authors": [
		{
			"name": "Newsman",
			"homepage": "https://www.newsman.ro/"
		}
	],
	"homepage": "https://www.newsman.ro/",
	"support": {
		"issues": "https://github.com/Newsman/WP-Plugin-NewsmanApp/issues",
		"wiki": "https://kb.newsman.ro/api/",
		"docs": "https://github.com/Newsman/WP-Plugin-NewsmanApp/blob/master/README.md",
		"source": "https://github.com/Newsman/WP-Plugin-NewsmanApp",
		"chat": "https://www.newsman.ro/",
		"email": "info@newsman.ro"
	},
	"keywords": [
		"newsman",
		"wordpress",
		"woocommerce",
		"newsletter",
		"search",
		"remarketing",
		"marketing",
		"email",
		"subscriber"
	],
	"require": {
		"php": ">=7.4.0",
		"composer/installers": "^1.0 || ^2.0",
		"greenlion/php-sql-parser": "^4.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpunit/phpunit": "^9.6",
		"roots/wordpress": "^7.1",
		"wp-coding-standards/wpcs": "^3.4",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/phpunit-polyfills": "^3.1"
	},
	"autoload": {
		"classmap": [
			"includes"
		],
		"psr-4": {
			"Newsman\\": ""
		},
		"exclude-from-classmap": [
			"/tests/"
		]
	},
	"config": {
		"platform": {
			"php": "7.4.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true,
			"composer/installers": true
		},
		"classmap-authoritative": true,
		"preferred-install": "dist",
		"prepend-autoloader": false,
		"sort-packages": true
	},
	"scripts": {
		"lint": "find . -path ./vendor -prune -o -path ./tests/wordpress -prune -o -path ./tests/tmp -prune -o -name '*.php' -print0 | xargs -0 -n1 -P4 php -l",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	}
}
